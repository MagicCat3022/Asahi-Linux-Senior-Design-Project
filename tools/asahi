def build_parser():
    formatter = argparse.RawDescriptionHelpFormatter
    width = max(map(len, COMMANDS)) + 2
    listing = "\n\n".join(group + ":\n" + "\n".join(f"  {name:<{width}}{COMMANDS[name][0]}" for name in names)
                          for group, names in GROUPS)
    parser = argparse.ArgumentParser(
        prog="./tools/asahi", usage="%(prog)s COMMAND [options]", formatter_class=formatter, description=__doc__,
        epilog=listing + "\n\nRun ./tools/asahi COMMAND --help for its options and examples.\n"
               "How it works: docs/overview.md. Every command: docs/reference/asahi-tool.md.")
    sub = parser.add_subparsers(dest="operation", required=True, metavar="COMMAND", help=argparse.SUPPRESS)

    def command(name):
        summary, details, examples = COMMANDS[name]
        return sub.add_parser(name, formatter_class=formatter,
                              description=textwrap.fill(summary + ".", 79)
                              + ("\n\n" + textwrap.fill(details, 79) if details else ""),
                              epilog="examples:\n" + "\n".join("  ./tools/asahi " + line for line in examples))

    profiles = profile_names()
    p = command("status")
    p.add_argument("--json", action="store_true", help="Print machine-readable JSON")
    p = command("doctor")
    p.add_argument("--online", action="store_true", help="Also check SSH, sudo, and sshd on the Mac")
    p = command("ssh")
    p.add_argument("command", nargs=argparse.REMAINDER, help="Remote command, after --")
    p = command("logs")
    p.add_argument("--run-dir", help="Run folder to show (default: latest run)")
    command("bundles")
    p = command("init")
