    command("setup-host")
    command("authorize")
    command("discover")
    command("capture")
    p = command("usb")
    p.add_argument("action", choices=["list", "bind", "attach", "detach"], help="What to do")
    p.add_argument("--busid", help="Windows USB bus ID (default: usb_busid from asahi.local.json)")
    p.add_argument("--once", action="store_true", help="With attach: attach once instead of watching")
    p = command("adopt")
