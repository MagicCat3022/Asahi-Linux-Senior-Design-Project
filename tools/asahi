    p.add_argument("--bundle", help="Bundle to boot (default: the selected bundle)")
    p.add_argument("--run-dir", help="Run folder for logs (default: a new one)")
    p.add_argument("--wait", type=float, default=0, help="Seconds to wait for the proxy port (default: %(default)s)")
    p.add_argument("--require-console", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--diagnostic", action="store_true", help="Stop in the initramfs shell instead of booting fully")
    p.add_argument("--dry-run", action="store_true", help="Print the boot plan and exit")
    p = command("console")
    p.add_argument("--run-dir", help="Run folder for serial.log (default: latest run)")
    command("proxy")
    p = command("evidence")
    p.add_argument("destination", help="The experiment's evidence folder, docs/experiments/DATE-SLUG/evidence")
    p.add_argument("--run-dir", help="Run to copy (default: latest run)")
    p.add_argument("--driver-check", action="append", default=[], metavar="REPORT",
                   help="Driver-check report to include; repeatable (default: same-kernel reports taken during the run)")
    p.add_argument("--skip-logs", action="store_true",
                   help="Publish only structured records; leave .log files out of both repositories")
    return parser


def main():
    args = build_parser().parse_args()
    if args.operation == "init":
        if CONFIG.exists():
            fail("asahi.local.json already exists; edit it to change hosts or paths")
        save(CONFIG, {"schema": 1, **DEFAULTS, "target": args.target, "identity": args.identity,
             "m1n1_dir": args.m1n1_dir, "build_source": args.source, "usb_busid": args.busid})
        config()
        print("Created", CONFIG)
        print("Next: ./tools/asahi setup-host")
        return
    if args.operation == "status":
        status = gather_status()
        if args.json:
            print(json.dumps(status, indent=2))
        else:
            print_status(status)
        return
    cfg = config()
    op = args.operation
    if op == "authorize":
        identity = local_path(cfg["identity"])
        identity.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if not identity.exists():
            subprocess.run(["ssh-keygen", "-t", "ed25519", "-f", str(identity), "-N", "", "-C", "asahi-hv-wsl"], check=True)
        subprocess.run(["ssh-copy-id", "-i", str(identity) + ".pub", cfg["target"]], check=True)
    elif op == "setup-host":
        for command in (["sudo", "apt", "update"], ["sudo", "apt", "install", "-y", "python3", "git", "make", "curl", "tmux", "usbutils", "udev", "gcc-aarch64-linux-gnu", "binutils-aarch64-linux-gnu"],
                        ["sudo", "install", "-m", "644", str(local_path(cfg["m1n1_dir"]) / "udev/80-m1n1.rules"), "/etc/udev/rules.d/80-m1n1.rules"],
                        ["sudo", "systemctl", "start", "systemd-udevd.service"], ["sudo", "udevadm", "control", "--reload-rules"]):
            subprocess.run(command, check=True)
        if "dialout" not in subprocess.check_output(["id", "-nG"], text=True).split():
            subprocess.run(["sudo", "usermod", "-aG", "dialout", os.environ["USER"]], check=True)
            print("Restart your login session to activate the dialout group.")
    elif op == "doctor":
        doctor(cfg, args)
    elif op == "discover":
        target = remote(cfg, "discover")
        save(STATE / "target.json", target)
        print(json.dumps(target, indent=2))
        print("HV arguments:", boot_arguments(target))
    elif op == "capture":
        metadata = remote(cfg, "capture")
        save(STATE / "target.json", metadata)
        receive_bundle(cfg, metadata, "installed-running-kernel")
    elif op == "adopt":
        adopt_bundle(cfg, local_path(args.path))
    elif op == "bundles":
        for path in sorted((STATE / "bundles").glob("*/manifest.json")):
            manifest = load(path)
            active = "*" if path.parent == local_path(cfg["bundle"]) else " "
            print(active, manifest["release"], manifest["origin"], str(path.parent.relative_to(ROOT)))
    elif op == "use":
        path = local_path(args.path)
        manifest = validate_bundle(path, load(STATE / "target.json"))
        cfg["bundle"] = str(path)
        save(CONFIG, cfg)
        print("Active bundle:", manifest["release"], path)
    elif op == "build":
        if args.jobs < 1:
            fail("--jobs must be positive")
        localversion = args.localversion or "-sdp-" + stamp().lower()
        if not re.fullmatch(r"-[a-zA-Z0-9._+\-]+", localversion):
            fail("--localversion must start with - and contain only release characters")
        make_args = cfg.get("make_args", ["LLVM=1"]) + args.make_arg
        if any(x.startswith("LOCALVERSION=") for x in make_args):
            fail("Use --localversion instead of a LOCALVERSION make argument")
        settings = {"source": args.source or cfg["build_source"], "output": args.output,
                    "make_args": make_args + ["LOCALVERSION=" + localversion], "jobs": args.jobs}
        if args.profile:
            settings["driver_profile"] = driver_profile(args.profile)
        if args.dry_run:
            print(json.dumps(remote(cfg, "plan", settings), indent=2))
            return
        directory = STATE / "builds" / stamp()
        directory.mkdir(parents=True)
        print("Building on", cfg["target"], "Log:", directory / "build.log", flush=True)
        result = remote(cfg, "build", settings, log=directory / "build.log")
        save(directory / "build.json", result)
        save(STATE / "latest-build.json", result)
        print("Built:", result["release"], "Next: ./tools/asahi stage")
    elif op == "stage":
        settings = load(STATE / "latest-build.json")
        if args.profile:
            settings["driver_profile"] = driver_profile(args.profile)
        log = STATE / "builds" / ("stage-" + stamp() + ".log")
        log.parent.mkdir(parents=True, exist_ok=True)
        print("Staging new modules and initramfs. Log:", log, flush=True)
        metadata = remote(cfg, "stage", settings, log=log)
        receive_bundle(cfg, metadata, "native-development-build")
        remote(cfg, "cleanup", metadata)
    elif op == "driver-check":
        bundle = local_path(args.bundle or cfg["bundle"])
        target = load(STATE / "target.json")
        manifest = validate_bundle(bundle, target)
        if args.profile:
            profile = driver_profile(args.profile)
        elif manifest.get("provenance", {}).get("driver_profile"):
            profile = manifest["provenance"]["driver_profile"]
        else:
            matching = profiles_for(target["compatible"])
            if len(matching) != 1:
                fail(f"No single driver profile for {target['compatible']} (found: {', '.join(matching) or 'none'}). "
                     "Pass --profile, or add one in tools/profiles/; see docs/reference/asahi-tool.md#driver-profiles")
            profile = driver_profile(matching[0])
        if target["compatible"] != profile["compatible"]:
            fail(f"Profile {profile['name']} is for {profile['compatible']}, but this Mac is {target['compatible']}")
        if not (bundle / ".config").is_file():
            fail("Driver audit needs a bundle with the full .config")
        options = dict(line.split("=", 1) for line in (bundle / ".config").read_text().splitlines()
                       if line.startswith("CONFIG_") and "=" in line)
        result = remote(cfg, "driver-check", {"release": manifest["release"],
                        "profile": profile, "options": options, "live": args.live})
        report = STATE / "driver-checks" / (stamp() + ".json")
        save(report, result)
        print(json.dumps(result, indent=2))
        print("Driver report:", report)
        if not result["passed"]:
            fail("Driver check failed; see the report")
    elif op == "ssh":
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        result = subprocess.run(ssh_command(cfg, interactive=True) + ([shlex.join(command)] if command else []))
        sys.exit(result.returncode)
    elif op == "usb":
        if not in_wsl():
            fail("usb is only for WSL. On native Linux, the Mac's m1n1 device appears directly as /dev/m1n1.")
        script = subprocess.check_output(["wslpath", "-w", str(ROOT / "tools/windows/Asahi-Usb.ps1")], text=True).strip()
        command = ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script, "-Action", args.action]
        if args.busid or cfg.get("usb_busid"):
            command += ["-BusId", args.busid or cfg["usb_busid"]]
        if args.once:
            command += ["-Once"]
        subprocess.run(command, check=True)
    elif op == "console":
        directory = run_directory(args.run_dir)
        command = uv_command(cfg) + ["python", str(ROOT / "tools/asahi-serial.py"), cfg["console"], str(directory)]
        sys.exit(subprocess.call(command))
    elif op == "proxy":
        proxy_preflight(cfg)
        if not os.access(cfg["proxy"], os.R_OK | os.W_OK):
            fail("Proxy device absent/inaccessible. Attach the Mac's USB device to WSL first.")
        (STATE / "locks").mkdir(parents=True, exist_ok=True)
        with (STATE / "locks/proxy").open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                fail("Proxy/HV is already owned by a workflow process. Use hv commands.")
            directory = new_run()
            command = uv_command(cfg) + ["python", str(local_path(cfg["m1n1_dir"]) / "proxyclient/tools/shell.py")]
            sys.exit(relay(command, directory / "proxy.log", {**proxy_environment(cfg), "M1N1DEVICE": cfg["proxy"]}))
    elif op == "boot":
        boot(cfg, args)
    elif op == "session":
        session(cfg, args)
    elif op == "hv":
        pane = cfg.get("session", "asahi-hv") + ":hv"
        if args.action == "interrupt":
            subprocess.run(["tmux", "send-keys", "-t", pane, "C-c"], check=True)
        elif args.action in {"resume", "command"}:
            text = "cont" if args.action == "resume" else args.text
            if not text or "\n" in text or "\r" in text:
                fail("Supply a single HV shell command")
            subprocess.run(["tmux", "send-keys", "-t", pane, "-l", text], check=True)
            subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
        else:
            subprocess.run(["tmux", "capture-pane", "-p", "-t", pane, "-S", "-80"], check=True)
    elif op == "check":
        check(cfg, args)
    elif op == "logs":
        directory = run_directory(args.run_dir)
        print("Run:", directory)
        for name in ("serial.log", "hv.log", "proxy.log", "guest-health.log"):
            path = directory / name
            if path.exists():
                print("\n" + name + ":\n" + path.read_text(errors="replace")[-12000:])
    elif op == "evidence":
        evidence(cfg, args)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        print("asahi:", exc, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
